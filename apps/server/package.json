{
  "name": "@relay/server",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=../../.env dist/index.js",
    "agent": "tsx --env-file-if-exists=../../.env src/agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "notion:sync": "tsx --env-file-if-exists=../../.env scripts/notion-sync.ts",
    "links:rebuild": "tsx --env-file-if-exists=../../.env scripts/links-rebuild.ts",
    "push:keys": "tsx scripts/vapid-keys.ts",
    "device:setup": "tsx --env-file-if-exists=../../.env scripts/fetch-scrcpy-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@relay/shared": "workspace:*",
    "@fastify/rate-limit": "^11.2.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "googleapis": "^189.0.0",
    "pino": "^10.4.0",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
