# Copy to .env (git-ignored). Never commit real values.

# 32 random bytes, base64 or hex. Encrypts secrets at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# Web Push (VAPID). Generate the three lines with: pnpm push:keys
# (the private key is a secret; changing the pair invalidates every browser subscription)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional ntfy.sh fallback channel (works with the browser fully closed). The topic acts as a password:
# anyone who knows it can read your notifications, so pick a long random one. Server must be https.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Optional
# LOG_LEVEL=info
# DATA_DIR=./data
# NODE_ENV: `pnpm start` sets production, which drops the Vite port (5173) from the Host and Origin allowlist.

# The public webhook URL is not set here: enter your static ngrok domain in Settings > Public base URL.

# Docker only: the compose `ngrok` service tunnels NGROK_URL to the webhook listener.
# NGROK_AUTHTOKEN=
# NGROK_URL=https://your-domain.ngrok-free.app

# Docker only: git, flutter and vu run on the Mac through the host agent (`pnpm agent`), with the Mac's own toolchain.
# The token is shared by the dashboard and the agent: `openssl rand -hex 32`.
# HOST_AGENT_TOKEN=
# HOST_AGENT_PORT=3002
# Optional: an HTTP proxy git uses for the repo host (for a GitLab on a private network). Unset = direct.
# HOST_AGENT_GIT_PROXY=

# Builds. BUILD_TIMEOUT_MIN limits one build job, in minutes.
# Builds do not see variables whose names look secret (*PASSWORD*, *TOKEN*, ...). If your Gradle signing reads some,
# set them in this file and list their NAMES here. They go to the build process only, and are redacted from its log.
# BUILD_TIMEOUT_MIN=30
# BUILD_PASS_ENV=KEYSTORE_PASSWORD,KEY_PASSWORD

# Custom release engine (Settings > General > Safety & engine): an executable that takes vu's arguments.
# Unset = vu from tools/bin (or VU_BIN_DIR). In Docker, set it in the host agent's .env.
# RELEASE_COMMAND=

# Listeners (defaults shown). The dashboard ONLY accepts 127.0.0.1; the webhook listener defaults to
# loopback too because the ngrok agent runs on this machine and forwards to it.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=3000
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=3001

# Phone access through the `tailscale` compose service (see docs/GUIDE.md, Docker).
# DASHBOARD_TLS_HOSTS=relay.your-tailnet.ts.net
# DASHBOARD_TLS_USERS=you@example.com

# ── Test Bench ────────────────────────────────────────────────────────────────
# Design frames come from the Figma MCP bridge (https://github.com/gethopp/figma-mcp-bridge): no token. Install its plugin in the
# Figma desktop app (Plugins > Development > Import plugin from manifest), then run it in the file you are testing against.
# The dashboard starts the bridge itself; override the command only if you need to:
# FIGMA_BRIDGE_CMD=npx -y @gethopp/figma-mcp-bridge
# The phone mirror needs the scrcpy server once on the Mac: pnpm --filter @relay/server device:setup

# ── Mobile Dev Cockpit ────────────────────────────────────────────────────────
# AI runs through the Claude CLI on the Mac (`claude -p`, your existing subscription). Optional fallback:
# ANTHROPIC_API_KEY=
# Path to the Claude CLI when it is not on PATH (host agent / local server):
# CLAUDE_BIN=claude
# Cockpit workspaces must live under these directories on the Mac (comma list):
# HOST_AGENT_WORKSPACE_ROOTS=~/Work
