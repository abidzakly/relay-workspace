{
  "name": "relay",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @relay/server --filter @relay/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @relay/server start",
    "agent": "pnpm --filter @relay/server agent",
    "typecheck": "pnpm -r typecheck",
    "push:keys": "pnpm --filter @relay/server push:keys",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
